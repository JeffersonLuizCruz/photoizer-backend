# --- Backend (Java + Maven) ---
# Padrões relativos à raiz DESTE repositório (photoizer-backend/). O prefixo
# "photoizer-backend/" não casava aqui e permitia versionar build/runtime.
target/
*.class
*.jar
*.war
*.log
.sts4-cache/
.vscode/

# Uploads / dados de runtime (podem conter PII, comprovantes e banco)
uploads/
data/
logs/
*.mv.db
*.trace.db

# Maven wrapper (the jar is large; keep the scripts but ignore the jar)
.mvn/wrapper/maven-wrapper.jar

# --- Frontend (Node + Vite + TypeScript) ---
photoizer-frontend/node_modules/
photoizer-frontend/dist/
photoizer-frontend/dev-dist/

# --- Documentação ---
# Arquivos Markdown não são versionados. AGENTS.md/MODULE.md já rastreados
# permanecem no índice; novos .md passam a ser ignorados.
*.md

# --- IDE ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Environment ---
.env
.env.local
.env.*.local
