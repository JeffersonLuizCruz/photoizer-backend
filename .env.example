# Exemplo de variaveis de ambiente do backend.
# NUNCA commite valores reais. Em homolog/prod, defina-as no Coolify (por ambiente).

# Perfil Spring: dev | homolog | prod
SPRING_PROFILES_ACTIVE=dev

# Datasource PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/photoizer
SPRING_DATASOURCE_USERNAME=photoizer
SPRING_DATASOURCE_PASSWORD=photoizer

# Segredo JWT (>= 32 bytes). Gere com: openssl rand -base64 48
JWT_SECRET=

# Bootstrap/rotacao de ADMIN e AGENDADOR.
# Os usuarios iniciais (ADMIN e AGENDADOR) sao semeados pelo Flyway
# (V2__seed_usuarios_iniciais.sql) com a senha padrao 'dev123'. Fora de dev, o
# AdminCredentialRotationSeeder forca a troca no boot a partir destas variaveis
# (sem elas, ADMIN_PASSWORD ausente falha o boot em prod e o AGENDADOR e
# desativado). ADMIN_EMAIL/ADMIN_PASSWORD tambem servem de rede de seguranca se
# a tabela users estiver vazia. Senhas exigem >= 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AGENDADOR_PASSWORD=
ADMIN_BOOTSTRAP_REQUIRED=false

# Cookies exigem HTTPS em homolog/prod
COOKIE_SECURE=false

# Origens permitidas (vazio quando o frontend faz proxy same-domain de /api)
APP_CORS_ALLOWED_ORIGINS=

# Diretorio de uploads (volume persistente no container)
UPLOAD_DIR=uploads
LOG_PATH=logs

TZ=America/Sao_Paulo
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
